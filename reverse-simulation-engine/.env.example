# Firebase Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# Firebase Admin SDK (Backend only)
FIREBASE_ADMIN_SDK_PATH=./firebase-service-account.json

# Backend Configuration
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Frontend Configuration (React)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_API_BASE_URL=http://localhost:3001/api

# Database
FIRESTORE_EMULATOR_HOST=localhost:8080
DATABASE_EMULATOR=false

# Security
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRE_IN=7d

# Monitoring & Logging
SENTRY_DSN=your_sentry_dsn
ENABLE_MONITORING=true

# Feature Flags
ENABLE_ADVANCED_SCENARIOS=false
ENABLE_WHAT_IF_ANALYSIS=false

# Application Settings
APP_NAME=DISHA Reverse Simulation Engine
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
