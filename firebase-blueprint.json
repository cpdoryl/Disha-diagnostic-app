{
  "entities": {
    "School": {
      "title": "School Profile",
      "description": "Registered actual school operational details and demographics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "city": { "type": "string" },
        "board": { "type": "string" },
        "tier": { "type": "string" },
        "feeBand": { "type": "string" },
        "studentCount": { "type": "string" },
        "principalName": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "city", "board", "tier"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "classSection": { "type": "string" },
        "gender": { "type": "string" },
        "attendanceRate": { "type": "number" },
        "riskProfile": { "type": "string" },
        "academicPerformance": { "type": "number" }
      },
      "required": ["id", "name", "gradeLevel", "classSection", "gender", "attendanceRate", "riskProfile", "academicPerformance"]
    },
    "StaffMember": {
      "title": "Staff Member",
      "description": "Staff member record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "subject": { "type": "string" },
        "tenureMonths": { "type": "number" },
        "performanceScore": { "type": "number" }
      },
      "required": ["id", "name", "role", "subject", "tenureMonths", "performanceScore"]
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Daily attendance record for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "date", "studentId", "studentName", "status"]
    },
    "CommunicationMessage": {
      "title": "Communication Message",
      "description": "Broadcast message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "sender": { "type": "string" },
        "timestamp": { "type": "string" },
        "recipientGroup": { "type": "string" }
      },
      "required": ["id", "title", "content", "sender", "timestamp", "recipientGroup"]
    },
    "ChallengeDomain": {
      "title": "Challenge Domain",
      "description": "Domain data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "score": { "type": "number" },
        "trend": { "type": "string" }
      },
      "required": ["id", "title", "description", "score", "trend"]
    },
    "Dimension": {
      "title": "Dimension",
      "description": "Dimension data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "name": { "type": "string" },
        "score": { "type": "number" },
        "benchmark": { "type": "number" }
      },
      "required": ["id", "categoryId", "categoryName", "name", "score", "benchmark"]
    },
    "GapPrediction": {
      "title": "Gap Prediction",
      "description": "Gap prediction data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "domainId": { "type": "string" },
        "domainName": { "type": "string" },
        "gapVsStandard": { "type": "number" },
        "gapVsPeer": { "type": "number" },
        "priorityRank": { "type": "number" },
        "rootCause": { "type": "string" },
        "recommendation": { "type": "string" }
      },
      "required": ["id", "domainId", "domainName", "gapVsStandard", "gapVsPeer", "priorityRank", "rootCause", "recommendation"]
    },
    "SimulationModel": {
      "title": "Simulation Model",
      "description": "Simulation model data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "targetMetric": { "type": "string" },
        "targetValue": { "type": "number" },
        "currentValue": { "type": "number" },
        "confidenceTier": { "type": "string" },
        "districtPrecedent": { "type": "string" },
        "requiredChanges": { "type": "array" }
      },
      "required": ["id", "targetMetric", "targetValue", "currentValue", "confidenceTier", "districtPrecedent", "requiredChanges"]
    },
    "SupportRequest": {
      "title": "Support Request",
      "description": "DPDP-compliant support request ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "consentGiven": { "type": "boolean" },
        "consentNotice": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "email", "category", "message", "consentGiven", "consentNotice", "timestamp"]
    }
  },
  "firestore": {
    "schools/{schoolId}": {
      "schema": { "$ref": "#/entities/School" },
      "description": "Registered schools database"
    },
    "students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Students collection"
    },
    "staff/{staffId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Staff collection"
    },
    "attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Attendance collection"
    },
    "communications/{commId}": {
      "schema": { "$ref": "#/entities/CommunicationMessage" },
      "description": "Communications collection"
    },
    "domains/{domainId}": {
      "schema": { "$ref": "#/entities/ChallengeDomain" },
      "description": "Domains collection"
    },
    "dimensions/{dimensionId}": {
      "schema": { "$ref": "#/entities/Dimension" },
      "description": "Dimensions collection"
    },
    "gaps/{gapId}": {
      "schema": { "$ref": "#/entities/GapPrediction" },
      "description": "Gaps collection"
    },
    "simulations/{simulationId}": {
      "schema": { "$ref": "#/entities/SimulationModel" },
      "description": "Simulations collection"
    },
    "support_requests/{requestId}": {
      "schema": { "$ref": "#/entities/SupportRequest" },
      "description": "DPDP support requests"
    }
  }
}
