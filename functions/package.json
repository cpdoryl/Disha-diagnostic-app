{
  "name": "disha-firestore-setup",
  "version": "1.0.0",
  "description": "DISHA Firestore initialization functions",
  "main": "lib/index.js",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.8.2",
    "vitest": "^2.0.5"
  }
}
